{
  "name": "Task",
  "type": "object",
  "properties": {
    "task_type": {
      "type": "string",
      "enum": [
        "todo",
        "task",
        "punch_list"
      ],
      "default": "task"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "job_address": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "waiting",
        "needs_review",
        "completed",
        "closed",
        "on_hold",
        "blocked",
        "canceled"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "due_date": {
      "type": "string",
      "description": "ISO date YYYY-MM-DD"
    },
    "due_time": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "completion_notes": {
      "type": "string"
    },
    "photos": {
      "type": "string",
      "description": "JSON array of photo/attachment URLs"
    },
    "linked_calendar_event_id": {
      "type": "string"
    },
    "linked_daily_log_id": {
      "type": "string"
    },
    "follow_up_needed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "task_type",
    "title",
    "status"
  ]
}