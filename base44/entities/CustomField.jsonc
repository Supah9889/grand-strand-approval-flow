{
  "name": "CustomField",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Display label shown to users"
    },
    "field_key": {
      "type": "string",
      "description": "Internal key used to store value on job (snake_case)"
    },
    "field_type": {
      "type": "string",
      "enum": [
        "text",
        "textarea",
        "number",
        "currency",
        "date",
        "dropdown",
        "yes_no",
        "phone",
        "email",
        "readonly"
      ],
      "default": "text"
    },
    "dropdown_options": {
      "type": "string",
      "description": "JSON array of option strings for dropdown type"
    },
    "help_text": {
      "type": "string"
    },
    "default_value": {
      "type": "string"
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "visibility": {
      "type": "string",
      "enum": [
        "admin_only",
        "staff_visible",
        "all"
      ],
      "default": "admin_only",
      "description": "Minimum role required to see this field"
    },
    "editable_by": {
      "type": "string",
      "enum": [
        "admin_only",
        "staff_editable"
      ],
      "default": "admin_only"
    },
    "apply_to_groups": {
      "type": "string",
      "description": "JSON array of job_group values this field applies to, or empty for all"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "label",
    "field_key",
    "field_type"
  ]
}