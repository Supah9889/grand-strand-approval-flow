{
  "name": "Job",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "company_slug": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Job title / project name"
    },
    "job_number": {
      "type": "string",
      "description": "Internal job number e.g. JOB-2026-001"
    },
    "job_type": {
      "type": "string",
      "description": "Job type from managed JobType list"
    },
    "service_line": {
      "type": "string",
      "enum": [
        "water_mitigation",
        "mold_mitigation",
        "air_sample_testing",
        "reconstruction",
        "emergency_response",
        "interior_painting",
        "exterior_painting",
        "drywall",
        "insulation",
        "cabinet_painting",
        "epoxy_garage_floor",
        "other"
      ],
      "description": "Service line for this job"
    },
    "address": {
      "type": "string",
      "description": "Full assembled job site address"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer full name"
    },
    "customer_id": {
      "type": "string",
      "description": "Customer entity ID"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "property_id": {
      "type": "string",
      "description": "Property entity ID"
    },
    "billing_address": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "vendor_notes": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "color": {
      "type": "string"
    },
    "buildertrend_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "job_group": {
      "type": "string",
      "enum": [
        "painting",
        "drywall",
        "carpentry",
        "water_mitigation",
        "warranty",
        "estimate_only",
        "insurance",
        "builder_vendor",
        "residential",
        "commercial",
        "internal",
        "other"
      ],
      "default": "painting"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "presale",
        "open",
        "in_progress",
        "waiting",
        "completed",
        "warranty",
        "closed",
        "archived",
        "canceled",
        "on_hold"
      ],
      "default": "open"
    },
    "op_status": {
      "type": "string",
      "enum": [
        "new",
        "needs_review",
        "needs_scheduling",
        "waiting_homeowner",
        "waiting_builder",
        "waiting_vendor",
        "waiting_materials",
        "scheduled",
        "in_progress",
        "on_hold",
        "complete",
        "invoiced",
        "paid",
        "closed"
      ],
      "default": "new"
    },
    "op_status_updated_at": {
      "type": "string"
    },
    "op_status_updated_by": {
      "type": "string"
    },
    "op_status_note": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "archived"
      ],
      "default": "pending"
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "signature_url": {
      "type": "string"
    },
    "approval_timestamp": {
      "type": "string"
    },
    "terms_version": {
      "type": "string"
    },
    "approval_statement": {
      "type": "string"
    },
    "review_rating": {
      "type": "string",
      "enum": [
        "great",
        "okay",
        "not_good"
      ]
    },
    "review_feedback": {
      "type": "string"
    },
    "review_prompt_shown": {
      "type": "boolean",
      "default": false
    },
    "google_review_clicked": {
      "type": "boolean",
      "default": false
    },
    "internal_feedback_submitted": {
      "type": "boolean",
      "default": false
    },
    "custom_fields": {
      "type": "string"
    },
    "start_date": {
      "type": "string"
    },
    "actual_start_date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "actual_end_date": {
      "type": "string"
    },
    "work_days": {
      "type": "string"
    },
    "square_footage": {
      "type": "number"
    },
    "permit_number": {
      "type": "string"
    },
    "lot_info": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "assigned_employee_ids": {
      "type": "string",
      "description": "JSON array of assigned employee IDs"
    },
    "assigned_employee_names": {
      "type": "string",
      "description": "JSON array of assigned employee names"
    },
    "linked_estimate_id": {
      "type": "string"
    },
    "linked_estimate_number": {
      "type": "string"
    },
    "linked_invoice_id": {
      "type": "string"
    },
    "linked_invoice_number": {
      "type": "string"
    },
    "xactimate_import_id": {
      "type": "string",
      "description": "XactimateImport entity ID if this job came from Xactimate"
    },
    "insurance_claim_number": {
      "type": "string"
    },
    "insurance_carrier": {
      "type": "string"
    },
    "insurance_adjuster_name": {
      "type": "string"
    },
    "insurance_adjuster_phone": {
      "type": "string"
    },
    "insurance_adjuster_email": {
      "type": "string"
    },
    "loss_date": {
      "type": "string"
    },
    "loss_type": {
      "type": "string"
    },
    "source_system": {
      "type": "string",
      "enum": [
        "app",
        "imported",
        "manual_entry",
        "buildertrend"
      ],
      "default": "app"
    },
    "qb_customer_id": {
      "type": "string"
    },
    "qb_project_id": {
      "type": "string"
    },
    "qb_sync_status": {
      "type": "string",
      "enum": [
        "not_synced",
        "pending",
        "synced",
        "failed"
      ],
      "default": "not_synced"
    },
    "qb_export_batch_id": {
      "type": "string"
    },
    "qb_export_date": {
      "type": "string"
    },
    "signature_document_mode": {
      "type": "string"
    },
    "source_work_order_file_url": {
      "type": "string"
    },
    "source_work_order_file_name": {
      "type": "string"
    },
    "signature_placement": {
      "type": "string"
    },
    "signed_output_file_url": {
      "type": "string"
    },
    "archived_at": {
      "type": "string"
    },
    "archived_by": {
      "type": "string"
    },
    "archived_reason": {
      "type": "string"
    }
  },
  "required": [
    "address",
    "customer_name",
    "description",
    "price"
  ]
}