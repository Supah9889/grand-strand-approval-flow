{
  "name": "JobTemplate",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "company_slug": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Template display name"
    },
    "service_line": {
      "type": "string",
      "enum": [
        "water_mitigation",
        "mold_mitigation",
        "air_sample_testing",
        "reconstruction",
        "emergency_response",
        "interior_painting",
        "exterior_painting",
        "drywall",
        "insulation",
        "cabinet_painting",
        "epoxy_garage_floor",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "default_priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "default_work_order_templates": {
      "type": "string",
      "description": "JSON array of WorkOrderTemplate IDs to auto-create"
    },
    "required_documentation": {
      "type": "string",
      "description": "JSON array of {label, requirement_type, description} objects"
    },
    "required_photo_sets": {
      "type": "string",
      "description": "JSON array of {label, description, timing} objects"
    },
    "required_notes": {
      "type": "string",
      "description": "JSON array of {label, description} objects"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}