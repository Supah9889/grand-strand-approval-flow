{
  "name": "WarrantyItem",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "job_address": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "original_completion_date": {
      "type": "string"
    },
    "date_reported": {
      "type": "string",
      "description": "ISO date YYYY-MM-DD"
    },
    "created_by_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "issue_description": {
      "type": "string"
    },
    "area_location": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "paint_touchup",
        "drywall",
        "carpentry",
        "water_moisture",
        "material_defect",
        "workmanship",
        "customer_concern",
        "schedule_visit",
        "other"
      ],
      "default": "other"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "scheduled",
        "in_progress",
        "completed",
        "closed",
        "waiting_customer",
        "waiting_materials",
        "on_hold",
        "not_covered",
        "reopened"
      ],
      "default": "new"
    },
    "assigned_to": {
      "type": "string"
    },
    "customer_notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "appointment_required": {
      "type": "boolean",
      "default": false
    },
    "appointment_date": {
      "type": "string"
    },
    "appointment_start_time": {
      "type": "string"
    },
    "appointment_end_time": {
      "type": "string"
    },
    "appointment_notes": {
      "type": "string"
    },
    "linked_calendar_event_id": {
      "type": "string"
    },
    "follow_up_needed": {
      "type": "boolean",
      "default": false
    },
    "follow_up_notes": {
      "type": "string"
    },
    "resolution_summary": {
      "type": "string"
    },
    "resolution_date": {
      "type": "string"
    },
    "closed_date": {
      "type": "string"
    },
    "covered_under_warranty": {
      "type": "boolean",
      "default": true
    },
    "coverage_decision_notes": {
      "type": "string"
    },
    "photos": {
      "type": "string",
      "description": "JSON array of photo URLs"
    },
    "files": {
      "type": "string",
      "description": "JSON array of {url, name, uploaded_at}"
    }
  },
  "required": [
    "job_id",
    "title",
    "status"
  ]
}