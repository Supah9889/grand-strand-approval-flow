{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "company_slug": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_code": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "job_address": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "work_order_title": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "cost_code": {
      "type": "string",
      "enum": [
        "Carpentry Labor/Sub",
        "Drywall Labor/Sub",
        "Other Labor/Sub",
        "Paint Expenses",
        "Painting Labor/Sub"
      ]
    },
    "cost_code_id": {
      "type": "string"
    },
    "role_on_job": {
      "type": "string",
      "enum": [
        "lead",
        "crew",
        "supervisor",
        "estimator",
        "other"
      ],
      "default": "crew"
    },
    "labor_category": {
      "type": "string"
    },
    "entry_date": {
      "type": "string",
      "description": "ISO date YYYY-MM-DD"
    },
    "clock_in": {
      "type": "string",
      "description": "ISO timestamp"
    },
    "clock_out": {
      "type": "string",
      "description": "ISO timestamp"
    },
    "duration_minutes": {
      "type": "number"
    },
    "total_hours": {
      "type": "number"
    },
    "hourly_rate": {
      "type": "number"
    },
    "labor_cost": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "clocked_in",
        "clocked_out",
        "needs_review",
        "edited"
      ],
      "default": "clocked_in"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "approved_by": {
      "type": "string"
    },
    "entry_source": {
      "type": "string",
      "enum": [
        "employee_clock",
        "admin_manual",
        "admin_edit"
      ],
      "default": "employee_clock"
    },
    "manual_adjustment": {
      "type": "boolean",
      "default": false
    },
    "employee_note": {
      "type": "string"
    },
    "admin_note": {
      "type": "string"
    },
    "memo": {
      "type": "string"
    },
    "edit_reason": {
      "type": "string"
    },
    "edit_history": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    },
    "last_updated_by": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "source_system": {
      "type": "string",
      "enum": [
        "app",
        "imported",
        "manual_entry"
      ],
      "default": "app"
    },
    "qb_time_activity_id": {
      "type": "string"
    },
    "qb_employee_id": {
      "type": "string"
    },
    "qb_sync_status": {
      "type": "string",
      "enum": [
        "not_synced",
        "pending",
        "synced",
        "failed",
        "needs_review"
      ],
      "default": "not_synced"
    },
    "qb_export_batch_id": {
      "type": "string"
    },
    "qb_export_date": {
      "type": "string"
    },
    "qb_export_error": {
      "type": "string"
    },
    "qb_export_attempt_count": {
      "type": "number",
      "default": 0
    },
    "punch_in_lat": {
      "type": "number"
    },
    "punch_in_lng": {
      "type": "number"
    },
    "punch_in_accuracy_meters": {
      "type": "number"
    },
    "punch_in_location_status": {
      "type": "string",
      "enum": [
        "captured",
        "denied",
        "unavailable"
      ]
    },
    "punch_in_distance_miles": {
      "type": "number"
    },
    "punch_in_flagged": {
      "type": "boolean",
      "default": false
    },
    "punch_out_lat": {
      "type": "number"
    },
    "punch_out_lng": {
      "type": "number"
    },
    "punch_out_accuracy_meters": {
      "type": "number"
    },
    "punch_out_location_status": {
      "type": "string",
      "enum": [
        "captured",
        "denied",
        "unavailable"
      ]
    },
    "punch_out_distance_miles": {
      "type": "number"
    },
    "punch_out_flagged": {
      "type": "boolean",
      "default": false
    },
    "geo_flagged": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "job_id",
    "cost_code",
    "clock_in"
  ]
}