{
  "name": "Payment",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "job_address": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "payment_date": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "check",
        "ach",
        "card",
        "cash",
        "zelle",
        "venmo",
        "other"
      ],
      "default": "check"
    },
    "reference_number": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "recorded_by": {
      "type": "string"
    },
    "qb_payment_id": {
      "type": "string"
    },
    "qb_sync_status": {
      "type": "string",
      "enum": [
        "not_synced",
        "pending",
        "synced"
      ],
      "default": "not_synced"
    }
  },
  "required": [
    "job_id",
    "amount",
    "payment_date"
  ]
}