{
  "name": "ApprovedEmail",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Approved outbound sender email address"
    },
    "display_name": {
      "type": "string",
      "description": "Friendly display name e.g. Grand Strand Custom Painting"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the default sender"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "email"
  ]
}