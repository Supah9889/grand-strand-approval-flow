{
  "name": "DailyLog",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "job_address": {
      "type": "string"
    },
    "log_date": {
      "type": "string",
      "description": "ISO date YYYY-MM-DD"
    },
    "created_by_name": {
      "type": "string"
    },
    "crew_present": {
      "type": "string",
      "description": "Names or description of who was on site"
    },
    "crew_count": {
      "type": "number"
    },
    "work_completed": {
      "type": "string"
    },
    "delays_issues": {
      "type": "string"
    },
    "materials_delivered": {
      "type": "string"
    },
    "general_notes": {
      "type": "string"
    },
    "weather": {
      "type": "string",
      "enum": [
        "sunny",
        "cloudy",
        "rain",
        "storm",
        "windy",
        "cold",
        "hot",
        "humid",
        "other"
      ]
    },
    "weather_notes": {
      "type": "string"
    },
    "safety_notes": {
      "type": "string"
    },
    "subcontractors_present": {
      "type": "string"
    },
    "visitors_inspectors": {
      "type": "string"
    },
    "equipment_used": {
      "type": "string"
    },
    "start_conditions": {
      "type": "string"
    },
    "end_status": {
      "type": "string"
    },
    "photos": {
      "type": "string",
      "description": "JSON array of photo URLs"
    },
    "follow_up_needed": {
      "type": "boolean",
      "default": false
    },
    "follow_up_note": {
      "type": "string"
    },
    "follow_up_assigned_to": {
      "type": "string"
    },
    "follow_up_status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved"
      ],
      "default": "open"
    },
    "source_system": {
      "type": "string",
      "enum": [
        "app",
        "imported",
        "buildertrend"
      ],
      "default": "app",
      "description": "Origin of this record"
    },
    "import_batch_id": {
      "type": "string",
      "description": "ImportBatch entity ID \u2014 set for all BT-imported records"
    },
    "source_file_name": {
      "type": "string",
      "description": "Original export file name"
    },
    "source_row": {
      "type": "number",
      "description": "Row/block number within the source file"
    },
    "raw_source_text": {
      "type": "string",
      "description": "Truncated raw source text for traceability (max ~1000 chars)"
    }
  },
  "required": [
    "job_id",
    "log_date",
    "work_completed"
  ]
}