{
  "name": "ReviewFeedback",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewer_role": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "feedback_text": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewed",
        "accepted",
        "deferred",
        "rejected"
      ],
      "default": "new"
    },
    "response_note": {
      "type": "string",
      "description": "Internal response note (not visible to reviewer)"
    },
    "nexus_item_id": {
      "type": "string",
      "description": "NexusItem ID if sent to Nexus"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "reviewer_name",
    "feedback_text",
    "section"
  ]
}