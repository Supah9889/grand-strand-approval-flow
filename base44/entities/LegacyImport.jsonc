{
  "name": "LegacyImport",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "company_slug": {
      "type": "string"
    },
    "source_system": {
      "type": "string",
      "default": "Proven Jobs"
    },
    "import_type": {
      "type": "string",
      "enum": [
        "csv",
        "zip",
        "pdf",
        "manual"
      ],
      "default": "csv"
    },
    "original_file": {
      "type": "string",
      "description": "Uploaded file URL"
    },
    "original_file_name": {
      "type": "string"
    },
    "uploaded_by": {
      "type": "string"
    },
    "uploaded_at": {
      "type": "string",
      "description": "ISO datetime"
    },
    "status": {
      "type": "string",
      "enum": [
        "uploaded",
        "processing",
        "imported",
        "needs_review",
        "error",
        "archived"
      ],
      "default": "uploaded"
    },
    "record_count": {
      "type": "number"
    },
    "error_count": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "error_detail": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "source_system",
    "import_type"
  ]
}