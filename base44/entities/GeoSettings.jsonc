{
  "name": "GeoSettings",
  "type": "object",
  "properties": {
    "alert_radius_miles": {
      "type": "number",
      "default": 0.25,
      "description": "Allowed punch radius from job site in miles before triggering an alert"
    },
    "alert_email": {
      "type": "string",
      "description": "Email address to receive out-of-range punch alerts"
    },
    "geo_tracking_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether geolocation capture is active"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": []
}