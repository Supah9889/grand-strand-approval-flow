{
  "name": "Lead",
  "type": "object",
  "properties": {
    "contact_name": {
      "type": "string"
    },
    "company_id": {
      "type": "string",
      "description": "Owning company id for multi-tenant isolation. Backfilled by migrateCompanyOwnership; GLOBAL_ADMIN_UNASSIGNED means manual admin review is required."
    },
    "company_name": {
      "type": "string"
    },
    "contact_type": {
      "type": "string",
      "enum": [
        "lead",
        "prospect",
        "customer"
      ],
      "default": "lead"
    },
    "phone": {
      "type": "string"
    },
    "phone_secondary": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "email_secondary": {
      "type": "string"
    },
    "property_address": {
      "type": "string"
    },
    "mailing_address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "lead_source": {
      "type": "string",
      "enum": [
        "website",
        "google",
        "referral",
        "repeat_customer",
        "buildertrend",
        "facebook",
        "instagram",
        "yard_sign",
        "door_hanger",
        "nextdoor",
        "other"
      ]
    },
    "referral_source": {
      "type": "string",
      "description": "Name or ID of referral source"
    },
    "assigned_to": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new_lead",
        "contacted",
        "qualified",
        "estimate_scheduled",
        "estimate_in_progress",
        "estimate_sent",
        "waiting_on_approval",
        "follow_up_needed",
        "won",
        "lost",
        "converted_to_job",
        "no_response",
        "on_hold",
        "not_qualified",
        "duplicate",
        "archived"
      ],
      "default": "new_lead"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "follow_up_date": {
      "type": "string",
      "description": "ISO date"
    },
    "follow_up_time": {
      "type": "string"
    },
    "follow_up_notes": {
      "type": "string"
    },
    "last_contact_date": {
      "type": "string"
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "phone",
        "text",
        "email",
        "any"
      ]
    },
    "best_time_to_contact": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "presale_job_title": {
      "type": "string"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "interior_painting",
        "exterior_painting",
        "cabinet_painting",
        "deck_staining",
        "commercial_painting",
        "drywall_repair",
        "power_washing",
        "epoxy_floor",
        "other"
      ]
    },
    "work_scope_summary": {
      "type": "string"
    },
    "estimate_needed": {
      "type": "boolean",
      "default": true
    },
    "estimate_scheduled_date": {
      "type": "string"
    },
    "estimate_status": {
      "type": "string",
      "enum": [
        "not_started",
        "scheduled",
        "in_progress",
        "sent",
        "approved",
        "declined"
      ],
      "default": "not_started"
    },
    "proposal_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "sent",
        "approved",
        "declined"
      ],
      "default": "not_started"
    },
    "approximate_value": {
      "type": "number"
    },
    "billing_type": {
      "type": "string",
      "enum": [
        "customer_pay",
        "insurance",
        "builder",
        "property_manager",
        "other"
      ]
    },
    "requested_timeline": {
      "type": "string"
    },
    "urgency_level": {
      "type": "string",
      "enum": [
        "flexible",
        "within_month",
        "within_2_weeks",
        "asap"
      ],
      "default": "flexible"
    },
    "converted_to_job": {
      "type": "boolean",
      "default": false
    },
    "linked_job_id": {
      "type": "string"
    },
    "linked_job_address": {
      "type": "string"
    }
  },
  "required": [
    "contact_name",
    "status"
  ]
}
