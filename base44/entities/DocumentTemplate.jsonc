{
  "name": "DocumentTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "type": {
      "type": "string",
      "enum": [
        "estimate",
        "contract",
        "work_authorization",
        "invoice_support",
        "change_order",
        "other"
      ],
      "description": "Document type"
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded template file URL"
    },
    "version": {
      "type": "string",
      "description": "Version number e.g. v1.0"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "field_mappings": {
      "type": "string",
      "description": "JSON string of field mapping config"
    }
  },
  "required": [
    "name",
    "type"
  ]
}